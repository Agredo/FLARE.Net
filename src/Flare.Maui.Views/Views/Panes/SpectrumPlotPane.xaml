<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Flare.ViewModels;assembly=Flare.ViewModels"
             xmlns:controls="clr-namespace:Flare.Maui.Views.Controls"
             xmlns:theme="clr-namespace:Flare.Maui.Views.Theme"
             x:Class="Flare.Maui.Views.Panes.SpectrumPlotPane"
             x:DataType="vm:MainViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:FlareTheme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>

    <Grid RowDefinitions="*,Auto" RowSpacing="8">
        <Border Padding="0" BackgroundColor="{StaticResource ChartBackground}">
            <controls:SpectrumControl ViewModel="{Binding Spectrum}" />
        </Border>

        <Border Grid.Row="1" Padding="8" StrokeShape="{RoundRectangle CornerRadius=10}">
            <VerticalStackLayout Spacing="6">
                <FlexLayout Direction="Row" Wrap="Wrap">
                    <Button Text="Zoom zurücksetzen" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                            Command="{Binding Spectrum.ResetZoomCommand}" />
                    <Button Text="Zum Peak" Style="{StaticResource SecondaryButton}" Margin="0,0,6,6"
                            Command="{Binding Spectrum.ZoomToSelectionCommand}" />
                    <Button Text="Auswahl aufheben" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"
                            Command="{Binding ClearSelectionCommand}" />
                </FlexLayout>
                <Label Text="Klick: Peak wählen · Mausrad: Zoom · Ziehen: verschieben · Doppelklick: Reset"
                       Style="{StaticResource Caption}" IsVisible="{OnIdiom Phone=False, Default=True}" />
                <Label Text="Tippen: Peak wählen · Ziehen: verschieben" Style="{StaticResource Caption}"
                       IsVisible="{OnIdiom Phone=True, Default=False}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
