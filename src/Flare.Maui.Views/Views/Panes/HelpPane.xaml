<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:Flare.Maui.Views.Markup"
             xmlns:vm="clr-namespace:Flare.ViewModels;assembly=Flare.ViewModels"
             xmlns:theme="clr-namespace:Flare.Maui.Views.Theme"
             x:Class="Flare.Maui.Views.Panes.HelpPane"
             x:DataType="vm:MainViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <theme:FlareTheme />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="HelpAnswer" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="1.35" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="18,8" HorizontalOptions="Fill" VerticalOptions="Start">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{m:Translate Help}" Style="{StaticResource AppTitle}" />
                    <Label Text="{m:Translate HelpSubtitle}" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="{m:Translate Close}" Style="{StaticResource SecondaryButton}"
                        Clicked="OnDismissRequested" AutomationId="CloseHelpButton" VerticalOptions="Center" />
            </Grid>
        </Border>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" MaximumWidthRequest="860" Margin="0,0,0,20">

                <Border>
                    <Label Text="{m:Translate HelpIntro}" Style="{StaticResource Muted}" />
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{m:Translate HelpQStart}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpAStart}" Style="{StaticResource HelpAnswer}" />
                    </VerticalStackLayout>
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{m:Translate HelpQScore}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpAScore}" Style="{StaticResource HelpAnswer}" />
                    </VerticalStackLayout>
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{m:Translate HelpQPeaks}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpAPeaks}" Style="{StaticResource HelpAnswer}" />
                    </VerticalStackLayout>
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{m:Translate HelpQNormalization}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpANormalization}" Style="{StaticResource HelpAnswer}" />
                        <BoxView HeightRequest="1" Color="{StaticResource PanelBorder}" Margin="0,4" />
                        <Label Text="{m:Translate HelpQThreshold}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpAThreshold}" Style="{StaticResource HelpAnswer}" />
                        <BoxView HeightRequest="1" Color="{StaticResource PanelBorder}" Margin="0,4" />
                        <Label Text="{m:Translate HelpQColormap}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpAColormap}" Style="{StaticResource HelpAnswer}" />
                    </VerticalStackLayout>
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{m:Translate HelpQStructure}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpAStructure}" Style="{StaticResource HelpAnswer}" />
                        <BoxView HeightRequest="1" Color="{StaticResource PanelBorder}" Margin="0,4" />
                        <Label Text="{m:Translate HelpQPlot}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpAPlot}" Style="{StaticResource HelpAnswer}" />
                    </VerticalStackLayout>
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{m:Translate HelpQCandidates}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpACandidates}" Style="{StaticResource HelpAnswer}" />
                        <BoxView HeightRequest="1" Color="{StaticResource PanelBorder}" Margin="0,4" />
                        <Label Text="{m:Translate HelpQManual}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpAManual}" Style="{StaticResource HelpAnswer}" />
                    </VerticalStackLayout>
                </Border>

                <Border>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{m:Translate HelpQModel}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpAModel}" Style="{StaticResource HelpAnswer}" />
                        <BoxView HeightRequest="1" Color="{StaticResource PanelBorder}" Margin="0,4" />
                        <Label Text="{m:Translate HelpQPlatform}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpAPlatform}" Style="{StaticResource HelpAnswer}" />
                        <BoxView HeightRequest="1" Color="{StaticResource PanelBorder}" Margin="0,4" />
                        <Label Text="{m:Translate HelpQLanguage}" Style="{StaticResource Header}" />
                        <Label Text="{m:Translate HelpALanguage}" Style="{StaticResource HelpAnswer}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
