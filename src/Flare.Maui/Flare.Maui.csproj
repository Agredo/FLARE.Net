<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props defaults TargetFramework to net8.0; the SDK only cross-targets when it is empty -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(MauiWindowsTargetFramework);$(MauiAndroidTargetFramework)</TargetFrameworks>
    <OutputType Condition="$(TargetFramework.Contains('-windows'))">WinExe</OutputType>
    <OutputType Condition="$(TargetFramework.Contains('-android'))">Exe</OutputType>
    <RootNamespace>Flare.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>FLARE</ApplicationTitle>
    <ApplicationId>com.flare.maui</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType Condition="$(TargetFramework.Contains('-windows'))">None</WindowsPackageType>
    <!-- A single-file (self-contained) publish has to carry the Windows App SDK runtime itself; a normal
         build keeps using the framework reference so it stays small and debuggable. -->
    <WindowsAppSDKSelfContained Condition="$(TargetFramework.Contains('-windows')) And '$(PublishSingleFile)' == 'true'">true</WindowsAppSDKSelfContained>
    <!-- RDKit2DotNetStandard ships Windows x64 natives only, so the Windows app defaults to win-x64.
         The RID can be overridden (win-arm64) from the command line for the release pipeline.
         On ARM64 Windows the x64 build runs through x64 emulation; the native win-arm64 build uses NCDK. -->
    <RuntimeIdentifiers Condition="$(TargetFramework.Contains('-windows')) And '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="$(TargetFramework.Contains('-windows')) And '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <FlareUseRdkit Condition="$(TargetFramework.Contains('-windows')) And '$(FlareUseRdkit)' == '' And '$(RuntimeIdentifier)' == 'win-arm64'">false</FlareUseRdkit>
    <FlareUseRdkit Condition="$(TargetFramework.Contains('-windows')) And '$(FlareUseRdkit)' == ''">true</FlareUseRdkit>
    <DefineConstants Condition="'$(FlareUseRdkit)' == 'true'">$(DefineConstants);FLARE_RDKIT</DefineConstants>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">$(MauiWindowsMinVersion)</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">$(MauiWindowsMinVersion)</TargetPlatformMinVersion>
    <!-- Release builds must yield an installable .apk (not an .aab) -->
    <AndroidPackageFormats Condition="$(TargetFramework.Contains('-android'))">apk</AndroidPackageFormats>
    <!-- Directory.Build.props defaults PlatformTarget to x64 for the RDKit natives; Android must stay neutral
         so the APK can target arm64 as well. -->
    <PlatformTarget Condition="$(TargetFramework.Contains('-android'))">AnyCPU</PlatformTarget>
    <!-- onnxruntime.aar requires at least API 24 -->
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1A1A2E" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="$(SkiaSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flare.Services\Flare.Services.csproj" />
    <ProjectReference Include="..\Flare.Chem\Flare.Chem.csproj" />
    <ProjectReference Include="..\Flare.Maui.Services\Flare.Maui.Services.csproj" />
    <ProjectReference Include="..\Flare.Maui.Views\Flare.Maui.Views.csproj" />
  </ItemGroup>

  <!-- RDKit only exists for Windows x64 (the NuGet package ships win-x64 natives only); Android and
       the native win-arm64 build use the NCDK port instead. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows')) And '$(FlareUseRdkit)' == 'true'">
    <ProjectReference Include="..\Flare.Rdkit\Flare.Rdkit.csproj" />
  </ItemGroup>

  <!-- Ship the exported model next to the executable when it exists (see flare_onnx/README).
       FlareService locates flare.onnx by file path, so it must stay a loose file next to the exe
       instead of being embedded into the single-file bundle. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-windows')) And Exists('..\..\..\flare_onnx\flare.onnx')">
    <None Include="..\..\..\flare_onnx\flare.onnx" Link="flare.onnx"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Release APK signing. The keystore and its credentials stay outside the repo and are read from
       the environment (FLARE_ANDROID_KEYSTORE / _KEY_ALIAS / _STORE_PASS / _KEY_PASS); without them
       the Release build still succeeds but produces an unsigned package. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) And '$(Configuration)' == 'Release' And '$(FLARE_ANDROID_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(FLARE_ANDROID_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="'$(FLARE_ANDROID_KEY_ALIAS)' != ''">$(FLARE_ANDROID_KEY_ALIAS)</AndroidSigningKeyAlias>
    <AndroidSigningStorePass Condition="'$(FLARE_ANDROID_STORE_PASS)' != ''">$(FLARE_ANDROID_STORE_PASS)</AndroidSigningStorePass>
    <AndroidSigningKeyPass Condition="'$(FLARE_ANDROID_KEY_PASS)' != ''">$(FLARE_ANDROID_KEY_PASS)</AndroidSigningKeyPass>
  </PropertyGroup>

</Project>

