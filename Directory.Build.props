<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- RDKit2DotNetStandard ships Windows x64 native DLLs only -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- native DLLs in the package's lib folder trigger MSB3246 -->
    <NoWarn>$(NoWarn);MSB3246</NoWarn>
  </PropertyGroup>
  <!-- MAUI front ends: Windows (full analysis) and Android (depiction only, RDKit has no Android natives) -->
  <PropertyGroup>
    <MauiVersion>10.0.130</MauiVersion>
    <SkiaSharpVersion>3.119.4</SkiaSharpVersion>
    <MauiWindowsTargetFramework>net10.0-windows10.0.19041.0</MauiWindowsTargetFramework>
    <MauiWindowsMinVersion>10.0.17763.0</MauiWindowsMinVersion>
    <MauiAndroidTargetFramework>net10.0-android36.0</MauiAndroidTargetFramework>
  </PropertyGroup>
</Project>

